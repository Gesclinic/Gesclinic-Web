-- Cash Flow core table aligned to Gesclinic requirements
-- Creates enums, table, helper transfer function, triggers from AP/AR, and summary RPC

-- Enums
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'cash_flow_type') THEN
    CREATE TYPE cash_flow_type AS ENUM ('entrada','saida','transferencia');
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'cash_flow_origin') THEN
    CREATE TYPE cash_flow_origin AS ENUM ('manual','contas_pagar','contas_receber','conciliacao');
  END IF;
END$$;

-- Table
CREATE TABLE IF NOT EXISTS public.cash_flow (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  clinic_id uuid NOT NULL,
  date date NOT NULL DEFAULT (current_date),
  description text NOT NULL DEFAULT '',
  type cash_flow_type NOT NULL,
  amount numeric(14,2) NOT NULL CHECK (amount >= 0),
  category_id uuid NULL, -- references account_plans(id) when available
  cost_center_id uuid NULL,
  account_id uuid NULL,
  origin cash_flow_origin NOT NULL DEFAULT 'manual',
  reference_id uuid NULL,
  is_reconciled boolean NOT NULL DEFAULT false,
  created_at timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_cash_flow_clinic ON public.cash_flow (clinic_id);
CREATE INDEX IF NOT EXISTS idx_cash_flow_date ON public.cash_flow (date);
CREATE INDEX IF NOT EXISTS idx_cash_flow_account ON public.cash_flow (account_id);

-- Helper: Transfer between accounts (creates 2 rows linked by same reference_id)
CREATE OR REPLACE FUNCTION public.cash_flow_transfer(
  p_clinic_id uuid,
  p_date date,
  p_description text,
  p_amount numeric,
  p_account_from uuid,
  p_account_to uuid,
  p_category_id uuid DEFAULT NULL,
  p_cost_center_id uuid DEFAULT NULL,
  p_reference_id uuid DEFAULT NULL
)
RETURNS void
LANGUAGE plpgsql
AS $$
DECLARE
  v_ref uuid := COALESCE(p_reference_id, gen_random_uuid());
BEGIN
  -- saída da conta origem
  INSERT INTO public.cash_flow (clinic_id, date, description, type, amount, category_id, cost_center_id, account_id, origin, reference_id)
  VALUES (p_clinic_id, p_date, COALESCE(p_description,'Transferência entre contas'), 'saida', ABS(p_amount), p_category_id, p_cost_center_id, p_account_from, 'manual', v_ref);

  -- entrada na conta destino
  INSERT INTO public.cash_flow (clinic_id, date, description, type, amount, category_id, cost_center_id, account_id, origin, reference_id)
  VALUES (p_clinic_id, p_date, COALESCE(p_description,'Transferência entre contas'), 'entrada', ABS(p_amount), p_category_id, p_cost_center_id, p_account_to, 'manual', v_ref);
END;
$$;

-- Trigger: AP -> cash_flow (on status paid)
CREATE OR REPLACE FUNCTION public.cash_flow_from_ap_bills()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
  IF (TG_OP = 'UPDATE') THEN
    IF (NEW.status = 'paid' AND COALESCE(OLD.status,'') <> 'paid') THEN
      INSERT INTO public.cash_flow (clinic_id, date, description, type, amount, category_id, cost_center_id, account_id, origin, reference_id)
      VALUES (
        NEW.clinic_id,
        CURRENT_DATE,
        COALESCE(NEW.description, 'Pagamento de fornecedor'),
        'saida',
        COALESCE(NEW.paid_amount, NEW.amount, 0),
        NEW.category_id,
        NULL,
        NULL,
        'contas_pagar',
        NEW.id
      );
    END IF;
  END IF;
  RETURN NEW;
END;
$$;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name='ap_bills') THEN
    DROP TRIGGER IF EXISTS cash_flow_from_ap_trg ON public.ap_bills;
    CREATE TRIGGER cash_flow_from_ap_trg
      AFTER UPDATE OF status ON public.ap_bills
      FOR EACH ROW EXECUTE FUNCTION public.cash_flow_from_ap_bills();
  END IF;
END$$;

-- Trigger: AR/Invoices -> cash_flow (on status paid)
CREATE OR REPLACE FUNCTION public.cash_flow_from_invoices()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
  IF (TG_OP = 'UPDATE') THEN
    IF (NEW.status = 'paid' AND COALESCE(OLD.status,'') <> 'paid') THEN
      INSERT INTO public.cash_flow (clinic_id, date, description, type, amount, category_id, cost_center_id, account_id, origin, reference_id)
      VALUES (
        NEW.clinic_id,
        COALESCE(NEW.paid_at, CURRENT_DATE),
        COALESCE('Recebimento ' || COALESCE(NEW.description, 'fatura'), 'Recebimento'),
        'entrada',
        COALESCE(NEW.total, 0),
        NULL,
        NULL,
        NULL,
        'contas_receber',
        NEW.id
      );
    END IF;
  END IF;
  RETURN NEW;
END;
$$;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name='invoices') THEN
    DROP TRIGGER IF EXISTS cash_flow_from_invoices_trg ON public.invoices;
    CREATE TRIGGER cash_flow_from_invoices_trg
      AFTER UPDATE OF status ON public.invoices
      FOR EACH ROW EXECUTE FUNCTION public.cash_flow_from_invoices();
  END IF;
END$$;

-- Summary RPC: entradas, saídas, resultado líquido e saldo final no período
CREATE OR REPLACE FUNCTION public.cashflow_summary(
  p_clinic_id uuid,
  p_start date,
  p_end date
)
RETURNS TABLE (
  entradas numeric,
  saidas numeric,
  resultado_liquido numeric,
  saldo_final numeric
)
LANGUAGE sql
AS $$
  WITH filtered AS (
    SELECT * FROM public.cash_flow
     WHERE clinic_id = p_clinic_id
       AND (p_start IS NULL OR date >= p_start)
       AND (p_end   IS NULL OR date <= p_end)
  )
  SELECT
    COALESCE(SUM(CASE WHEN type = 'entrada' THEN amount END), 0) AS entradas,
    COALESCE(SUM(CASE WHEN type = 'saida' THEN amount END), 0)    AS saidas,
    COALESCE(SUM(CASE WHEN type = 'entrada' THEN amount END), 0) -
    COALESCE(SUM(CASE WHEN type = 'saida' THEN amount END), 0)    AS resultado_liquido,
    COALESCE(SUM(CASE WHEN type = 'entrada' THEN amount END), 0) -
    COALESCE(SUM(CASE WHEN type = 'saida' THEN amount END), 0)    AS saldo_final;
$$;
