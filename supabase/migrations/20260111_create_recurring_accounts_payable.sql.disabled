-- Recurring Accounts Payable table
create table if not exists public.recurring_accounts_payable (
  id uuid primary key default gen_random_uuid(),
  clinic_id uuid not null,
  supplier_id uuid,
  description text,
  value numeric,
  frequency text,
  start_date date,
  end_date date,
  chart_account_id uuid,
  cost_center text,
  payment_method text,
  active boolean default true
);

-- Helpful index for querying by clinic and activity
create index if not exists idx_rec_ap_clinic_active on public.recurring_accounts_payable (clinic_id, active);
