# Public Vite settings. These values are bundled into the browser.
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=example-publishable-key
VITE_SENTRY_DSN=
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:3000

# Configure these only in Supabase Edge Function secrets, never as VITE_*.
# SUPABASE_SERVICE_ROLE_KEY=example-server-only-key
# RESEND_API_KEY=example-server-only-key
# EVOLUTION_API_URL=https://example.invalid
# EVOLUTION_API_KEY=example-server-only-key
# EVOLUTION_INSTANCE=example
# APP_URL=https://homologacao.example.invalid
# STRIPE_SECRET_KEY=sk_test_example
# STRIPE_WEBHOOK_SECRET=whsec_example
# RESEND_FROM_EMAIL=relatorios@example.invalid
# TISS_ALLOWED_HOSTS=operadora-homologacao.example.invalid
