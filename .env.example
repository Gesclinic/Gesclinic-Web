# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Sentry Error Tracking (Optional)
# Get your DSN from: https://sentry.io/settings/
# If not provided, error tracking will be disabled gracefully
VITE_SENTRY_DSN=https://your-sentry-dsn-key@sentry.io/project-id

# App Configuration
VITE_APP_ENV=production
VITE_APP_URL=https://gesclinic-web.vercel.app

# Evolution API (WhatsApp Integration)
VITE_EVOLUTION_API_URL=https://your-evolution-api-url
VITE_EVOLUTION_API_KEY=your-evolution-api-key
VITE_EVOLUTION_INSTANCE=your-instance-name
