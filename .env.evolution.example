# Configuração Evolution API para WhatsApp
# Obter EvolucioAPI em https://evolution-api.com

# URL da API Evolution (localhost para testes)
VITE_EVOLUTION_API_URL=http://localhost:8080/message/sendText

# API Key da Evolution
VITE_EVOLUTION_API_KEY=seu_api_key_aqui

# Instância WhatsApp (nome da conexão)
VITE_EVOLUTION_INSTANCE=gesclinic

# URL do app para links de confirmação
VITE_APP_URL=http://localhost:3000

# Exemplo de arquivo .env.local com valores reais:
# VITE_EVOLUTION_API_URL=http://192.168.1.100:8080/message/sendText
# VITE_EVOLUTION_API_KEY=sk_live_abc123def456
# VITE_EVOLUTION_INSTANCE=minha_clinica
# VITE_APP_URL=http://localhost:3000
